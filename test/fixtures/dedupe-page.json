{
  "title": "Clean the list",
  "page-type": {
    "type": "dedupe",
    "configuration": {
      "scope": {
        "phase": "PRE_AWARD",
        "stage": "REVIEW_APPLICATION",
        "excludeStatuses": [
          "APPLICATION_REJECTED",
          "APPLICATION_WITHDRAWN",
          "WITHDRAWAL_REQUESTED"
        ]
      },
      "groupBy": [
        {
          "label": "SBI",
          "value": "$case.payload.identifiers.sbi"
        }
      ],
      "sort": [
        {
          "value": "@.details.sbi",
          "order": "descending"
        }
      ],
      "data": {
        "details": {
          "sbi": "@.key.sbi",
          "businessName": "function:first(@.cases, '$case.payload.answers.applicant.business.name')",
          "applicationsCount": "function:count(@.cases)",
          "excludedCount": "function:count(@.excludedCases)",
          "notSet": "function:unlabelledCount(@.activeCases)",
          "notDuplicate": "function:labelCount(@.activeCases, 'NOT_DUPLICATE')",
          "duplicate": "function:labelCount(@.activeCases, 'DUPLICATE')"
        },
        "assignee": {
          "name": "$group.assignee.name"
        },
        "status": {
          "tag": "function:groupStatus(@.activeCases)"
        }
      },
      "columns": {
        "details": [
          {
            "component": "url",
            "text": "SBI @.sbi: @.businessName",
            "href": "@.groupHref"
          },
          {
            "component": "hint",
            "text": "@.applicationsCount applications: @.notSet Not set, @.notDuplicate Not duplicate, @.duplicate Duplicate; @.excludedCount excluded"
          }
        ],
        "assignee": [
          {
            "component": "text",
            "text": "@.name"
          }
        ],
        "status": [
          {
            "component": "status",
            "text": "@.tag",
            "labelsMap": {
              "NOT_STARTED": "Not started",
              "IN_PROGRESS": "In progress",
              "COMPLETED": "Completed"
            },
            "classesMap": {
              "NOT_STARTED": "govuk-tag--blue",
              "IN_PROGRESS": "govuk-tag--light-blue",
              "COMPLETED": "govuk-tag--green"
            }
          }
        ]
      }
    }
  }
}
