{
  "title": "Clean the list",
  "page-type": {
    "type": "dedupe",
    "configuration": {
      "scope": {
        "phase": "PRE_AWARD",
        "stage": "REVIEW_APPLICATION",
        "excludeStatuses": ["APPLICATION_REJECTED", "APPLICATION_WITHDRAWN"]
      },
      "groupBy": [
        {
          "label": "SBI",
          "value": "$case.payload.identifiers.sbi"
        }
      ],
      "display": {
        "businessName": "$case.payload.answers.applicant.business.name"
      }
    }
  }
}
